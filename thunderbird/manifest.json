{
  "manifest_version": 2,
  "name": "Linux Speaking",
  "description": "Lets the Linux Speaking dictation engine type into the message you are writing.",
  "homepage_url": "https://github.com/jontio/linux-speaking",
  "version": "0.5.0",
  "author": "Jonti Olds",
  "applications": {
    "gecko": { "id": "linux-speaking@jontio.github.io", "strict_min_version": "115.0" }
  },
  "permissions": ["compose", "tabs", "http://127.0.0.1/*"],
  "background": { "scripts": ["background.js"] }
}
