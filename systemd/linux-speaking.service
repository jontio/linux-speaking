[Unit]
Description=Linux Speaking (speech engine and tray icon)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
WorkingDirectory=%h/linux-speaking/app
ExecStart=%h/linux-speaking/venv/bin/python -m dictation.tray
Restart=on-failure
TimeoutStopSec=10
RestartSec=5

[Install]
WantedBy=graphical-session.target
